{
  "name": "chatgpt-to-public-page",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "release": "node --import tsx scripts/release.ts",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "build:installer": "wrangler deploy --config wrangler.installer.jsonc --dry-run --outdir dist/installer",
    "recovery-token": "node --import tsx scripts/recovery-token.ts",
    "test:browser": "node --import tsx --test tests/browser/*.test.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "fflate": "0.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@types/node": "26.6.4",
    "miniflare": "5.20261001.0-alpha",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  }
}
